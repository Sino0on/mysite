# Локальная разработка: скопируйте в .env.local.
# Сервер с Docker: скопируйте в .env рядом с docker-compose.yml.

# Адрес сайта без слэша в конце — для canonical, hreflang и sitemap.
# В Docker он вшивается при сборке: после смены нужен docker compose up -d --build.
NEXT_PUBLIC_SITE_URL=

# Заявки в Telegram. Токен выдаёт @BotFather. Chat ID — ваш числовой id
# (его покажет @userinfobot); сначала напишите своему боту /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Заявки на почту через Resend (resend.com → API Keys).
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Необязательно. Без своего домена в Resend письма уходят с onboarding@resend.dev
# и доставляются только на почту владельца аккаунта Resend.
# ORDER_EMAIL_FROM="Заявки с сайта <orders@your-domain.com>"

# Форма работает, если настроен хотя бы один канал — Telegram или почта.

# Только для Docker, необязательно: порт на сервере, который слушает контейнер.
# APP_PORT=3018
